# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8081
PORT=8081

# Data Protection keys (persisted in docker volume)
DATA_PROTECTION_KEYS_PATH=/app/keys

# App
AppSettings__ProjectName=Tiendubi
AppSettings__FrontendUrl=https://capturar.ordenapp.ar
OwnerSecurity__OwnerEmail=owner@tiendubi.com
Cors__AllowedOrigins=https://capturar.netlify.app,https://capturar.ordenapp.ar

# Database (VPS/managed postgres)
# If postgres is another container in same compose network, use Host=postgres
# Supabase direct example:
# ConnectionStrings__PostgresConnection=Host=YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=REPLACE_WITH_STRONG_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
# Supabase pooler example:
# ConnectionStrings__PostgresConnection=Host=aws-REGION.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=REPLACE_WITH_STRONG_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__PostgresConnection=Host=aws-1-us-west-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.ltazmebndetsnodwsggo;Password=REPLACE_WITH_STRONG_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Auth
Jwt__Secret=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS

# Google OAuth (optional)
Google__Enabled=false
Google__ClientId=
Google__ClientSecret=

# MercadoPago (production credentials)
MercadoPagoSettings__ClientId=APP_USR-REPLACE
MercadoPagoSettings__ClientSecret=REPLACE
MercadoPagoSettings__RedirectUri=https://api.capturar.ordenapp.ar/api/payments/mercadopago/callback
MercadoPagoSettings__CommissionPercentage=25
MercadoPagoSettings__PublicKey=APP_USR-REPLACE
MercadoPagoSettings__AccessToken=APP_USR-REPLACE
MercadoPagoSettings__SuccessUrl=https://capturar.ordenapp.ar/plans?payment=success
MercadoPagoSettings__FailureUrl=https://capturar.ordenapp.ar/plans?payment=failure
MercadoPagoSettings__PendingUrl=https://capturar.ordenapp.ar/plans?payment=pending
MercadoPagoSettings__NotificationUrl=https://api.capturar.ordenapp.ar/api/mercadopago/notify

# Cloudflare R2
R2__AccountId=REPLACE
R2__AccessKeyId=REPLACE
R2__SecretAccessKey=REPLACE
R2__BucketName=capturar
R2__PublicBaseUrl=https://pub-xxxxxxxx.r2.dev

# Email
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=no-reply@tiendubi.com
Email__SmtpPassword=REPLACE
Email__FromEmail=no-reply@tiendubi.com
Email__FromName=Tiendubi

# Feature flags
Features__RegistrationEnabled=true
Features__PhotoUploadEnabled=true

# Payment module
Payment__Enabled=true
Payment__MercadoPagoEnabled=true
Payment__TransfersEnabled=false
Payment__MonthlyPrice=2999
Payment__Currency=ARS
Payment__TrialDays=30
Payment__CommissionPercent=25
Payment__DiscountCode=
Payment__DiscountPercent=0
Payment__TransferHolderName=
Payment__TransferBankName=
Payment__TransferAlias=
Payment__TransferCbu=
Payment__TransferAccountInfo=

# Hosts
AllowedHosts=*

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8081
PORT=8081

# Data Protection keys (must be persisted in VPS/docker volume)
DATA_PROTECTION_KEYS_PATH=/app/keys

# App
AppSettings__ProjectName=Tiendubi
AppSettings__FrontendUrl=https://tudominio.com
OwnerSecurity__OwnerEmail=owner@tudominio.com

# Database
# Supabase direct example:
# ConnectionStrings__PostgresConnection=Host=YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
# Supabase pooler example:
# ConnectionStrings__PostgresConnection=Host=aws-REGION.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__PostgresConnection=Host=aws-1-us-west-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.ltazmebndetsnodwsggo;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# Auth
Jwt__Secret=CHANGE_ME_MIN_32_CHARS

# Google OAuth (optional)
Google__Enabled=false
Google__ClientId=
Google__ClientSecret=

# MercadoPago Marketplace OAuth + Checkout
MercadoPagoSettings__ClientId=CHANGE_ME
MercadoPagoSettings__ClientSecret=CHANGE_ME
MercadoPagoSettings__RedirectUri=https://api.tudominio.com/api/payments/mercadopago/callback
MercadoPagoSettings__CommissionPercentage=25
MercadoPagoSettings__PublicKey=CHANGE_ME
MercadoPagoSettings__AccessToken=CHANGE_ME
MercadoPagoSettings__SuccessUrl=https://tudominio.com/plans?payment=success
MercadoPagoSettings__FailureUrl=https://tudominio.com/plans?payment=failure
MercadoPagoSettings__PendingUrl=https://tudominio.com/plans?payment=pending
MercadoPagoSettings__NotificationUrl=https://api.tudominio.com/api/mercadopago/notify

# Cloudflare R2
R2__AccountId=CHANGE_ME
R2__AccessKeyId=CHANGE_ME
R2__SecretAccessKey=CHANGE_ME
R2__BucketName=capturar
R2__PublicBaseUrl=https://pub-xxxxxxxx.r2.dev

# Email
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=CHANGE_ME
Email__SmtpPassword=CHANGE_ME
Email__FromEmail=no-reply@tudominio.com
Email__FromName=Tiendubi

# Feature flags
Features__RegistrationEnabled=true
Features__PhotoUploadEnabled=true

# Payment module
Payment__Enabled=true
Payment__MercadoPagoEnabled=true
Payment__TransfersEnabled=false
Payment__MonthlyPrice=2999
Payment__Currency=ARS
Payment__TrialDays=30
Payment__CommissionPercent=25
Payment__DiscountCode=
Payment__DiscountPercent=0
Payment__TransferHolderName=
Payment__TransferBankName=
Payment__TransferAlias=
Payment__TransferCbu=
Payment__TransferAccountInfo=

# Hosts
AllowedHosts=*

# Automatic photo delivery retry worker
PhotoDeliveryRetry__Enabled=true
PhotoDeliveryRetry__MaxAttempts=5
PhotoDeliveryRetry__PollIntervalSeconds=60
PhotoDeliveryRetry__BackoffMinutes__0=0
PhotoDeliveryRetry__BackoffMinutes__1=1
PhotoDeliveryRetry__BackoffMinutes__2=5
PhotoDeliveryRetry__BackoffMinutes__3=30
PhotoDeliveryRetry__BackoffMinutes__4=120

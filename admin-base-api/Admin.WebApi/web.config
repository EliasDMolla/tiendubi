<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 1100 MiB: admite archivos Pro de 1 GiB más el contenido multipart. -->
        <requestLimits maxAllowedContentLength="1153433600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
